                showToast('保存容量制限またはブラウザ設定を確認してください', 'error');
            }
        }

        // Format Date Helper (YYYY/MM/DD HH:mm)
        function formatDateTime(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            const hh = String(dateObj.getHours()).padStart(2, '0');
            const mm = String(dateObj.getMinutes()).padStart(2, '0');
            return `${y}/${m}/${d} ${hh}:${mm}`;
        }

        function formatDateOnly(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        // Update Header Timestamp & Spread
        function updateHeaderTimestamp() {
            const el = document.getElementById('last-sync-time');
            if (el) el.textContent = appState.lastUpdated || '--';

            // Calculate US 10Y - JP 10Y Spread
            const jgb = appState.indicators.find(i => i.id === 'jgb10y');
            const ust = appState.indicators.find(i => i.id === 'ust10y');
            const spreadEl = document.getElementById('us-jp-spread');
            if (jgb && ust && spreadEl) {
                const spread = (Number(ust.value) - Number(jgb.value)).toFixed(3);
                spreadEl.textContent = `${spread > 0 ? '+' : ''}${spread}%`;
            }
        }

