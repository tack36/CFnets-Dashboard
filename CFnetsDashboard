        // ==========================================
        // CANDLESTICK CHART + 7-DAY & 200-DAY SMA ENGINE
        // ==========================================
        function computeSMA(dataArr, period) {
            const result = new Array(dataArr.length).fill(null);
            let sum = 0;
            for (let i = 0; i < dataArr.length; i++) {
                sum += dataArr[i].close;
                if (i >= period) {
                    sum -= dataArr[i - period].close;
                }
                if (i >= period - 1) {
                    result[i] = sum / period;
                }
            }
            return result;
        }

        function formatAssetPrice(val, assetKey) {
            if (val === null || val === undefined || isNaN(val)) return '--';
            if (assetKey === 'BTCJPY') return '¥' + Math.round(val).toLocaleString('ja-JP');
            if (assetKey === 'GOLDJPY') return '¥' + Math.round(val).toLocaleString('ja-JP') + '/g';
            if (assetKey === 'XAUUSD') return '$' + Number(val).toFixed(1);
            if (assetKey === 'USDJPY') return Number(val).toFixed(2) + '円';
            return Number(val).toLocaleString('ja-JP');
        }

        function switchChartAsset(assetKey, scrollIntoView = false) {
            currentChartAsset = assetKey;
            chartHoverIndex = null;

            document.querySelectorAll('.chart-asset-btn').forEach(btn => {
                const isTarget = btn.id === `tab-asset-${assetKey}`;
                if (isTarget) {
                    btn.className = 'chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-amber-500 text-white shadow-sm';
                } else {
                    btn.className = 'chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-1.5';
                }
            });

            drawCandlestickChart();
            if (scrollIntoView) {
                document.getElementById('section-chart-heading')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function setChartZoom(days) {
            currentChartZoom = days;
            chartHoverIndex = null;
            document.querySelectorAll('.chart-zoom-btn').forEach(btn => {
                const z = parseInt(btn.getAttribute('data-zoom'), 10);
                if (z === days) {
                    btn.className = 'chart-zoom-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition';
                } else {
                    btn.className = 'chart-zoom-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition';
                }
            });
            drawCandlestickChart();
        }

        function syncLatestIndicatorToOhlc() {
            // Keep the final candle of each series aligned with any manual edits on the KPI cards
            const btcInd = appState.indicators.find(i => i.id === 'btc_jpy');
            const goldInd = appState.indicators.find(i => i.id === 'gold_jpy');
            const fxInd = appState.indicators.find(i => i.id === 'usdjpy');

            if (btcInd && ohlcCache.series.BTCJPY?.length) {
                const last = ohlcCache.series.BTCJPY[ohlcCache.series.BTCJPY.length - 1];
                last.close = Number(btcInd.value);
                if (last.close > last.high) last.high = last.close;
                if (last.close < last.low) last.low = last.close;
            }
            if (goldInd && ohlcCache.series.GOLDJPY?.length) {
                const last = ohlcCache.series.GOLDJPY[ohlcCache.series.GOLDJPY.length - 1];
                last.close = Number(goldInd.value);
                if (last.close > last.high) last.high = last.close;
                if (last.close < last.low) last.low = last.close;
            }
            if (fxInd && ohlcCache.series.USDJPY?.length) {
                const last = ohlcCache.series.USDJPY[ohlcCache.series.USDJPY.length - 1];
                last.close = Number(fxInd.value);
                if (last.close > last.high) last.high = last.close;
                if (last.close < last.low) last.low = last.close;
            }
        }

        function drawCandlestickChart() {
            const canvas = document.getElementById('ohlc-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            syncLatestIndicatorToOhlc();

            const fullData = ohlcCache.series[currentChartAsset] || [];
            if (fullData.length === 0) return;

            // Compute 7-day and 200-day SMA across the full 260-day history so 200SMA is valid on all visible candles
            const sma7Full = computeSMA(fullData, 7);
            const sma200Full = computeSMA(fullData, 200);

            const visibleCount = Math.min(currentChartZoom, fullData.length);
            const startIndex = fullData.length - visibleCount;
            const visibleData = fullData.slice(startIndex);
            const visibleSma7 = sma7Full.slice(startIndex);
            const visibleSma200 = sma200Full.slice(startIndex);

            // High-DPI Canvas setup
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            const width = Math.max(300, rect.width);
            const height = Math.max(260, rect.height);
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            // Background
            ctx.fillStyle = '#090d16';
            ctx.fillRect(0, 0, width, height);

            const padLeft = 14;
            const padRight = 76;
            const padTop = 22;
            const padBottom = 28;
            const plotW = width - padLeft - padRight;
            const plotH = height - padTop - padBottom;

            // Determine price min/max including 7SMA and 200SMA
            let minPrice = Infinity;
            let maxPrice = -Infinity;
            for (let i = 0; i < visibleData.length; i++) {
                const d = visibleData[i];
                if (d.low < minPrice) minPrice = d.low;
                if (d.high > maxPrice) maxPrice = d.high;
                if (visibleSma7[i] !== null) {
                    if (visibleSma7[i] < minPrice) minPrice = visibleSma7[i];
                    if (visibleSma7[i] > maxPrice) maxPrice = visibleSma7[i];
                }
                if (visibleSma200[i] !== null) {
                    if (visibleSma200[i] < minPrice) minPrice = visibleSma200[i];
                    if (visibleSma200[i] > maxPrice) maxPrice = visibleSma200[i];
                }
            }
            const priceSpan = (maxPrice - minPrice) || 1;
            minPrice -= priceSpan * 0.05;
            maxPrice += priceSpan * 0.05;

            const priceToY = (p) => padTop + plotH - ((p - minPrice) / (maxPrice - minPrice)) * plotH;
            const stepX = plotW / visibleData.length;
            const indexToX = (i) => padLeft + (i + 0.5) * stepX;

            // Horizontal Grid Lines & Right Axis Labels
            const gridSteps = 5;
            ctx.strokeStyle = 'rgba(148, 163, 184, 0.12)';
            ctx.lineWidth = 1;
            ctx.fillStyle = '#94a3b8';
            ctx.font = '11px "JetBrains Mono", monospace';
            ctx.textAlign = 'left';

            for (let g = 0; g <= gridSteps; g++) {
                const y = padTop + (plotH / gridSteps) * g;
                const priceVal = maxPrice - ((maxPrice - minPrice) / gridSteps) * g;
                ctx.beginPath();
                ctx.moveTo(padLeft, y);
                ctx.lineTo(padLeft + plotW, y);
                ctx.stroke();

                ctx.fillText(formatAssetPrice(priceVal, currentChartAsset), padLeft + plotW + 6, y + 4);
            }

            // Vertical Date Grid Lines
            const dateStep = Math.max(1, Math.floor(visibleData.length / 6));
            ctx.textAlign = 'center';
            for (let i = 0; i < visibleData.length; i += dateStep) {
                const x = indexToX(i);
                ctx.beginPath();
                ctx.moveTo(x, padTop);
                ctx.lineTo(x, padTop + plotH);
                ctx.stroke();

                const dateLabel = visibleData[i].date.slice(5); // MM-DD
                ctx.fillStyle = '#64748b';
                ctx.fillText(dateLabel, x, height - 8);
            }

            // Draw Candlesticks
            const candleBodyWidth = Math.max(2, Math.min(14, stepX * 0.68));
            for (let i = 0; i < visibleData.length; i++) {
                const d = visibleData[i];
                const x = indexToX(i);
                const isBull = d.close >= d.open;
                const color = isBull ? '#10b981' : '#f43f5e';

                const highY = priceToY(d.high);
                const lowY = priceToY(d.low);
                const openY = priceToY(d.open);
                const closeY = priceToY(d.close);

                // Wick
                ctx.strokeStyle = color;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.moveTo(x, highY);
                ctx.lineTo(x, lowY);
                ctx.stroke();

                // Body
                const topY = Math.min(openY, closeY);
                const bodyH = Math.max(1.5, Math.abs(closeY - openY));
                ctx.fillStyle = color;
                ctx.fillRect(x - candleBodyWidth / 2, topY, candleBodyWidth, bodyH);
            }

            // Helper to draw SMA Line
            function drawSmaCurve(smaArr, strokeColor, lineWidth) {
                ctx.strokeStyle = strokeColor;
                ctx.lineWidth = lineWidth;
                ctx.lineJoin = 'round';
                ctx.lineCap = 'round';
                ctx.beginPath();
                let started = false;
                for (let i = 0; i < smaArr.length; i++) {
                    if (smaArr[i] === null) continue;
                    const x = indexToX(i);
                    const y = priceToY(smaArr[i]);
                    if (!started) {
                        ctx.moveTo(x, y);
                        started = true;
                    } else {
                        ctx.lineTo(x, y);
                    }
                }
                ctx.stroke();
            }

            // Draw 200-day SMA (Magenta/Purple) & 7-day SMA (Amber/Gold)
            drawSmaCurve(visibleSma200, '#d946ef', 2.2);
            drawSmaCurve(visibleSma7, '#fbbf24', 1.8);

            // Determine active index (hovered or latest candle)
            const activeIdx = (chartHoverIndex !== null && chartHoverIndex >= 0 && chartHoverIndex < visibleData.length)
                ? chartHoverIndex
                : visibleData.length - 1;

            // Crosshair if hovering
            if (chartHoverIndex !== null && chartHoverIndex >= 0 && chartHoverIndex < visibleData.length) {
                const cx = indexToX(chartHoverIndex);
                const cy = priceToY(visibleData[chartHoverIndex].close);

                ctx.strokeStyle = 'rgba(226, 232, 240, 0.45)';
                ctx.setLineDash([4, 4]);
                ctx.lineWidth = 1;

                ctx.beginPath();
                ctx.moveTo(cx, padTop);
                ctx.lineTo(cx, padTop + plotH);
                ctx.moveTo(padLeft, cy);
                ctx.lineTo(padLeft + plotW, cy);
                ctx.stroke();
                ctx.setLineDash([]);
            }

            // Update HUD Readout Bar
            const activeCandle = visibleData[activeIdx];
            const activeSma7 = visibleSma7[activeIdx];
            const activeSma200 = visibleSma200[activeIdx];

            document.getElementById('hud-date').textContent = activeCandle.date;
            document.getElementById('hud-open').textContent = formatAssetPrice(activeCandle.open, currentChartAsset);
            document.getElementById('hud-high').textContent = formatAssetPrice(activeCandle.high, currentChartAsset);
            document.getElementById('hud-low').textContent = formatAssetPrice(activeCandle.low, currentChartAsset);
            document.getElementById('hud-close').textContent = formatAssetPrice(activeCandle.close, currentChartAsset);
            document.getElementById('hud-sma7').textContent = activeSma7 ? formatAssetPrice(activeSma7, currentChartAsset) : '--';

            if (activeSma200) {
                const devPct = ((activeCandle.close - activeSma200) / activeSma200) * 100;
                const sign = devPct >= 0 ? '+' : '';
                document.getElementById('hud-sma200').textContent = `${formatAssetPrice(activeSma200, currentChartAsset)} (${sign}${devPct.toFixed(1)}%)`;
            } else {
                document.getElementById('hud-sma200').textContent = '--';
            }

            // Trend Signal Summary
            const latestCandle = visibleData[visibleData.length - 1];
            const latestSma7 = visibleSma7[visibleSma7.length - 1];
            const latestSma200 = visibleSma200[visibleSma200.length - 1];
            const signalEl = document.getElementById('chart-trend-signal');
            if (signalEl && latestSma7 && latestSma200) {
                const above200 = latestCandle.close >= latestSma200;
                const goldenOrder = latestSma7 >= latestSma200;
                if (above200 && goldenOrder) {
                    signalEl.className = 'font-semibold text-emerald-600 dark:text-emerald-400';
                    signalEl.innerHTML = '<i class="fa-solid fa-circle-arrow-up mr-1"></i>強気トレンド（現在値・7日線ともに200日移動平均線の上方で推移）';
                } else if (above200) {
                    signalEl.className = 'font-semibold text-amber-600 dark:text-amber-400';
                    signalEl.innerHTML = '<i class="fa-solid fa-circle-minus mr-1"></i>押し目・調整局面（200日移動平均線サポート維持）';
                } else {
                    signalEl.className = 'font-semibold text-rose-600 dark:text-rose-400';
