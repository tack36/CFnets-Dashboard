            };
        }

        let appState = loadState();
        let ohlcCache = loadOhlcCache();

        function loadState() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) {
                    const def = getDefaultState();
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(def));
                    return def;
                }
                const parsed = JSON.parse(raw);
                if (!parsed.indicators || !parsed.banks || !parsed.links) {
                    return getDefaultState();
                }
                // Ensure gold_jpy and btc_jpy exist if upgrading from earlier state
                const def = getDefaultState();
                def.indicators.forEach(defInd => {
                    const existing = parsed.indicators.find(i => i.id === defInd.id);
                    if (!existing) {
                        parsed.indicators.push(defInd);
                    } else if (defInd.benchmarks && !existing.benchmarks) {
                        existing.benchmarks = { ...defInd.benchmarks };
                    }
                });
                // Migrate default ticker 8801.T to 8876.T automatically
                const stockInd = parsed.indicators.find(i => i.id === 'company_stock');
                if (stockInd && (!stockInd.ticker || stockInd.ticker === '8801.T' || stockInd.ticker === '8801')) {
                    const defStock = def.indicators.find(i => i.id === 'company_stock');
                    stockInd.name = defStock.name;
                    stockInd.subtitle = defStock.subtitle;
                    stockInd.ticker = '8876.T';
                    stockInd.url = 'https://finance.yahoo.co.jp/quote/8876.T';
                    stockInd.value = defStock.value;
                    stockInd.change = defStock.change;
                    stockInd.history = [...defStock.history];
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));
                }
                return parsed;
            } catch (e) {
                console.error('LocalStorage読み込みエラー:', e);
                return getDefaultState();
            }
        }

        function loadOhlcCache() {
            try {
                const raw = localStorage.getItem(OHLC_STORAGE_KEY);
                if (!raw) {
                    const def = getDefaultOhlcCache();
                    localStorage.setItem(OHLC_STORAGE_KEY, JSON.stringify(def));
                    return def;
                }
                const parsed = JSON.parse(raw);
                if (!parsed.series || !parsed.series.BTCJPY || !parsed.series.GOLDJPY) {
                    return getDefaultOhlcCache();
                }
                return parsed;
            } catch (e) {
                return getDefaultOhlcCache();
            }
        }

        function saveOhlcCache() {
            try {
                localStorage.setItem(OHLC_STORAGE_KEY, JSON.stringify(ohlcCache));
            } catch (e) {
                console.warn('OHLCキャッシュ保存エラー:', e);
            }
        }

