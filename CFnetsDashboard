        function parseFirstNumber(str) {
            const match = String(str || '').match(/(\d+(\.\d+)?)/);
            return match ? parseFloat(match[1]) : 999;
        }

        function renderBankTable() {
            const tbody = document.getElementById('bank-table-body');
            const emptyState = document.getElementById('bank-empty-state');
            const countBadge = document.getElementById('bank-count-badge');
            const searchInput = document.getElementById('bank-search-input');
            const clearBtn = document.getElementById('btn-clear-search');
            const sortMode = document.getElementById('bank-sort-select').value;

            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
            if (clearBtn) {
                clearBtn.classList.toggle('hidden', query.length === 0);
            }

            let filtered = appState.banks.filter(b => {
                const matchCat = currentBankCategory === 'ALL' || b.category === currentBankCategory;
                if (!matchCat) return false;
                if (!query) return true;
                const haystack = `${b.name} ${b.branch} ${b.category} ${b.target} ${b.rate} ${b.rateType} ${b.term} ${b.ltv} ${b.notes}`.toLowerCase();
                return haystack.includes(query);
            });

            // Sort
            filtered.sort((a, b) => {
                if (sortMode === 'rate_asc') {
                    return parseFirstNumber(a.rate) - parseFirstNumber(b.rate);
                } else if (sortMode === 'name_asc') {
                    return (a.name || '').localeCompare(b.name || '', 'ja');
                } else {
                    return (b.updatedAt || '').localeCompare(a.updatedAt || '');
