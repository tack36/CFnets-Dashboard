            function formatDiffCell(curr, past) {
                const diff = curr - past;
                const sign = diff > 0 ? '+' : '';
                const cls = diff > 0
                    ? 'text-emerald-600 dark:text-emerald-400'
                    : diff < 0
                        ? 'text-rose-600 dark:text-rose-400'
                        : 'text-slate-500';
                return `
