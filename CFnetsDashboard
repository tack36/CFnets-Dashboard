                    <td class="py-3.5 px-4 align-top text-right whitespace-nowrap">
                        <div class="text-[11px] font-mono text-slate-400 mb-2">${escapeHtml(b.updatedAt || '')}</div>
                        <div class="inline-flex items-center gap-1">
                            <button onclick="openBankModal('${b.id}')" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-100 dark:hover:bg-blue-950 text-slate-600 dark:text-slate-300 hover:text-blue-600 transition" title="編集">
                                <i class="fa-solid fa-pen text-xs"></i>
                            </button>
                            <button onclick="duplicateBankCondition('${b.id}')" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-indigo-100 dark:hover:bg-indigo-950 text-slate-600 dark:text-slate-300 hover:text-indigo-600 transition" title="複製して別支店を作成">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                            <button onclick="deleteBankCondition('${b.id}')" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-100 dark:hover:bg-rose-950 text-slate-600 dark:text-slate-300 hover:text-rose-600 transition" title="削除">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function openBankModal(bankId = null) {
            const modalTitle = document.getElementById('bank-modal-title');
            if (bankId) {
                const b = appState.banks.find(item => item.id === bankId);
                if (!b) return;
                modalTitle.textContent = '金融機関 融資条件の編集';
                document.getElementById('bank-id').value = b.id;
                document.getElementById('bank-name').value = b.name || '';
                document.getElementById('bank-branch').value = b.branch || '';
                document.getElementById('bank-category').value = b.category || '地方銀行';
                document.getElementById('bank-target').value = b.target || '';
                document.getElementById('bank-rate').value = b.rate || '';
                document.getElementById('bank-rate-type').value = b.rateType || '';
                document.getElementById('bank-term').value = b.term || '';
                document.getElementById('bank-ltv').value = b.ltv || '';
                document.getElementById('bank-notes').value = b.notes || '';
            } else {
                modalTitle.textContent = '新規 金融機関条件の追加登録';
                document.getElementById('bank-id').value = '';
                document.getElementById('bank-form').reset();
            }
            document.getElementById('bank-modal').classList.remove('hidden');
        }

        function closeBankModal() {
            document.getElementById('bank-modal').classList.add('hidden');
        }

        function saveBankCondition(e) {
            e.preventDefault();
            const id = document.getElementById('bank-id').value;
            const entry = {
                id: id || ('bnk-' + Date.now()),
                name: document.getElementById('bank-name').value.trim(),
                branch: document.getElementById('bank-branch').value.trim(),
                category: document.getElementById('bank-category').value,
                target: document.getElementById('bank-target').value.trim(),
                rate: document.getElementById('bank-rate').value.trim(),
                rateType: document.getElementById('bank-rate-type').value.trim(),
                term: document.getElementById('bank-term').value.trim(),
                ltv: document.getElementById('bank-ltv').value.trim(),
                notes: document.getElementById('bank-notes').value.trim(),
                updatedAt: formatDateOnly(new Date())
            };

            if (id) {
                const idx = appState.banks.findIndex(b => b.id === id);
                if (idx !== -1) appState.banks[idx] = entry;
            } else {
                appState.banks.unshift(entry);
            }

            saveState(true);
            renderBankTable();
            closeBankModal();
            showToast(`「${entry.name}」の融資条件を保存しました`, 'success');
        }

        function duplicateBankCondition(id) {
            const orig = appState.banks.find(b => b.id === id);
            if (!orig) return;
            const copy = {
                ...orig,
                id: 'bnk-' + Date.now(),
                branch: (orig.branch ? orig.branch + ' (複製)' : '別支店'),
                updatedAt: formatDateOnly(new Date())
            };
            appState.banks.unshift(copy);
            saveState(true);
            renderBankTable();
            showToast(`「${orig.name}」の条件を複製しました`, 'info');
        }

        function deleteBankCondition(id) {
            const target = appState.banks.find(b => b.id === id);
            if (!target) return;
            appState.banks = appState.banks.filter(b => b.id !== id);
            saveState(true);
            renderBankTable();
            showToast(`「${target.name}」の条件を削除しました`, 'info');
        }

        // ==========================================
        // LOAN REPAYMENT & YIELD GAP SIMULATOR
        // ==========================================
        function toggleSimulatorPanel() {
            const panel = document.getElementById('simulator-section');
            panel.classList.toggle('hidden');
            if (!panel.classList.contains('hidden')) {
                runLoanSimulation();
            }
        }

        function runLoanSimulation() {
            const price = parseFloat(document.getElementById('sim-price').value) || 0;
            const loan = parseFloat(document.getElementById('sim-loan').value) || 0;
            const grossYield = parseFloat(document.getElementById('sim-yield').value) || 0;
            const annualRate = parseFloat(document.getElementById('sim-rate').value) || 0;
            const years = parseInt(document.getElementById('sim-years').value, 10) || 1;
            const opexRatio = parseFloat(document.getElementById('sim-opex').value) || 0;

            const months = years * 12;
            const monthlyRate = (annualRate / 100) / 12;

            let monthlyPayment = 0;
            if (loan > 0 && months > 0) {
                if (monthlyRate === 0) {
                    monthlyPayment = loan / months;
                } else {
                    monthlyPayment = loan * (monthlyRate * Math.pow(1 + monthlyRate, months)) / (Math.pow(1 + monthlyRate, months) - 1);
                }
            }

            const ads = monthlyPayment * 12;
            const loanConstantK = loan > 0 ? (ads / loan) * 100 : 0;
            const gpi = price * (grossYield / 100);
            const noi = gpi * (1 - opexRatio / 100);
            const fcr = price > 0 ? (noi / price) * 100 : 0;
            const yieldGap = fcr - loanConstantK;
            const btcf = noi - ads;
            const dscr = ads > 0 ? (noi / ads) : 0;

            document.getElementById('sim-out-monthly').textContent = `${monthlyPayment.toFixed(1)} 万円`;
            document.getElementById('sim-out-ads').textContent = `${ads.toFixed(1)} 万円`;
            document.getElementById('sim-out-k').textContent = `${loanConstantK.toFixed(2)}%`;

            const ygEl = document.getElementById('sim-out-yg');
            ygEl.textContent = `${yieldGap >= 0 ? '+' : ''}${yieldGap.toFixed(2)}%`;
            ygEl.className = `text-base font-bold font-mono tabular-nums ${yieldGap >= 1.5 ? 'text-emerald-400' : yieldGap >= 0 ? 'text-amber-300' : 'text-rose-400'}`;

            const btcfEl = document.getElementById('sim-out-btcf');
            btcfEl.textContent = `${btcf >= 0 ? '+' : ''}${btcf.toFixed(1)} 万円/年`;
            btcfEl.className = `ml-1.5 text-base font-mono ${btcf >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

            const dscrEl = document.getElementById('sim-out-dscr');
            dscrEl.textContent = `DSCR: ${dscr.toFixed(2)}`;
            dscrEl.className = `text-xs px-2 py-0.5 rounded font-mono ${dscr >= 1.2 ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}`;
        }

        // ==========================================
        // QUICK MEMO AUTO-SAVE
        // ==========================================
        function initQuickMemo() {
            const area = document.getElementById('quick-memo-textarea');
            if (area) area.value = appState.quickMemo || '';
        }

        function saveQuickMemo() {
            const area = document.getElementById('quick-memo-textarea');
            const status = document.getElementById('memo-save-status');
            if (!area) return;
            appState.quickMemo = area.value;
            saveState(true);
            if (status) {
                status.textContent = `自動保存済 (${formatDateTime(new Date()).split(' ')[1]})`;
            }
        }

        // ==========================================
        // BACKUP EXPORT / IMPORT / RESET
        // ==========================================
        function openBackupModal() {
            document.getElementById('backup-modal').classList.remove('hidden');
        }

        function closeBackupModal() {
            document.getElementById('backup-modal').classList.add('hidden');
        }

        function exportDataAsJson() {
            const dataStr = JSON.stringify(appState, null, 2);
            const blob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const dateTag = formatDateOnly(new Date()).replace(/-/g, '');
            a.href = url;
            a.download = `market_bank_dashboard_${dateTag}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('バックアップJSONファイルをダウンロードしました', 'success');
        }

        function copyJsonToClipboard() {
            const dataStr = JSON.stringify(appState, null, 2);
            const temp = document.createElement('textarea');
            temp.value = dataStr;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast('JSONデータをクリップボードにコピーしました', 'success');
        }

        function importDataFromJson(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (!imported.indicators || !imported.banks) {
                        showToast('無効なJSONフォーマットです', 'error');
                        return;
                    }
                    appState = imported;
                    saveState(true);
                    renderAll();
                    closeBackupModal();
                    showToast('バックアップデータを復元しました', 'success');
                } catch (err) {
                    showToast('JSONファイルの解析に失敗しました', 'error');
                }
            };
            reader.readAsText(file);
        }

        function resetToDefaultConfirm() {
            appState = getDefaultState();
            saveState(true);
            renderAll();
            closeBackupModal();
            showToast('初期サンプルデータにリセットしました', 'info');
        }

        // ==========================================
        // THEME TOGGLE & UTILITIES
        // ==========================================
        function toggleTheme() {
            const htmlEl = document.documentElement;
            htmlEl.classList.toggle('dark');
            const isDark = htmlEl.classList.contains('dark');
            localStorage.setItem('DASHBOARD_THEME', isDark ? 'dark' : 'light');
        }

        function initTheme() {
            const savedTheme = localStorage.getItem('DASHBOARD_THEME');
            if (savedTheme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const colors = {
                success: 'bg-emerald-600 text-white border-emerald-500',
                error: 'bg-rose-600 text-white border-rose-500',
                info: 'bg-slate-800 text-white border-slate-700'
            };
            const icons = {
                success: 'fa-circle-check',
                error: 'fa-triangle-exclamation',
                info: 'fa-circle-info'
            };

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-lg border text-xs sm:text-sm font-medium transition-all duration-300 ${colors[type] || colors.info}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type] || icons.info}"></i>
                <span>${escapeHtml(message)}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        function renderAll() {
            renderMarketCards();
            drawCandlestickChart();
            renderQuickLinks();
            renderBankTable();
            initQuickMemo();
            runLoanSimulation();
        }

        // Initialize on Window Load
        window.onload = function () {
            initTheme();
            updateNetworkStatus();
            initChartInteractions();
            renderAll();
            // Attempt non-blocking live FX, BTC & Gold OHLC refresh if online
            if (navigator.onLine) {
                syncLiveMarketData();
            }
        };
    </script>
</body>
