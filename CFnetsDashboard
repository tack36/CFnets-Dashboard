            if (ind.benchmarks) {
                const m1 = parseFloat(document.getElementById('ind-bm-m1').value);
                const m3 = parseFloat(document.getElementById('ind-bm-m3').value);
                const m6 = parseFloat(document.getElementById('ind-bm-m6').value);
