<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>マーケット＆金融機関条件ダッシュボード | Market & Financing Intelligence</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Inter"', '"Hiragino Kaku Gothic ProN"', '"Noto Sans JP"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', '"Roboto Mono"', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- PWA / Mobile Home Screen App Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="市況＆銀行条件">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* Custom Scrollbar & Financial Terminal Polish */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.5);
        }
        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }
        @keyframes pulse-subtle {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.65; }
        }
        .animate-pulse-subtle {
            animation: pulse-subtle 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen transition-colors duration-200 selection:bg-blue-500 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- Top Navigation / Status Header -->
    <header class="sticky top-0 z-30 backdrop-blur-md bg-white/95 dark:bg-slate-900/95 border-b border-slate-200 dark:border-slate-800 transition-colors shadow-sm">
        <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-2.5 sm:py-3">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2.5">
                
                <!-- Title & Network Badge -->
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white shadow-md shadow-blue-500/20 shrink-0">
                            <i class="fa-solid fa-chart-line text-base sm:text-lg"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h1 class="text-sm sm:text-lg md:text-xl font-bold tracking-tight text-slate-900 dark:text-white truncate">
                                    マーケット＆金融機関条件ダッシュボード
                                </h1>
                                <!-- Online/Offline Indicator -->
                                <span id="network-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 shrink-0">
                                    <span id="network-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                                    <span id="network-text">ONLINE</span>
                                </span>
                            </div>
                            <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 flex items-center gap-2 mt-0.5 truncate">
                                <span><i class="fa-regular fa-clock mr-1"></i>最終保存・取得: <strong id="last-sync-time" class="font-mono text-slate-700 dark:text-slate-300">--</strong></span>
                                <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
                                <span class="hidden sm:inline text-emerald-600 dark:text-emerald-400"><i class="fa-solid fa-database mr-1"></i>オフライン自動保持有効</span>
                            </p>
                        </div>
                    </div>

                    <!-- Mobile Quick Buttons (How-to & Theme) -->
                    <div class="flex items-center gap-1.5 md:hidden shrink-0">
                        <button onclick="openUsageGuideModal()" class="p-2 rounded-xl bg-blue-50 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/80 transition" title="スムーズな使い方ガイド">
                            <i class="fa-regular fa-circle-question text-sm"></i>
                        </button>
                        <button id="theme-toggle-mobile" onclick="toggleTheme()" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="テーマ切替">
                            <i class="fa-solid fa-moon dark:hidden text-sm"></i>
                            <i class="fa-solid fa-sun hidden dark:inline text-amber-400 text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Action Toolbar -->
                <div class="flex items-center flex-wrap gap-1.5 sm:gap-2">
                    <!-- Refresh / Fetch Latest Button -->
                    <button onclick="syncLiveMarketData()" id="btn-sync" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white shadow-sm shadow-blue-500/20 transition cursor-pointer">
                        <i id="sync-icon" class="fa-solid fa-arrows-rotate"></i>
                        <span>最新レート＆日足取得</span>
                    </button>

                    <!-- Simulator Quick Open -->
                    <button onclick="toggleSimulatorPanel()" class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm font-medium bg-indigo-50 hover:bg-indigo-100 text-indigo-700 dark:bg-indigo-950/60 dark:hover:bg-indigo-900/70 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/80 transition cursor-pointer">
                        <i class="fa-solid fa-calculator"></i>
                        <span>返済・YG試算</span>
                    </button>

                    <!-- Usage Guide Button (Desktop) -->
                    <button onclick="openUsageGuideModal()" class="hidden sm:inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium bg-amber-50 hover:bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:hover:bg-amber-900/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800/70 transition cursor-pointer" title="活用・ホーム画面追加ガイド">
                        <i class="fa-regular fa-lightbulb"></i>
                        <span>活用ガイド</span>
                    </button>

                    <!-- Export / Import Dropdown or Modal Button -->
                    <div class="relative inline-block">
                        <button onclick="openBackupModal()" class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition cursor-pointer" title="JSONデータ管理・初期化">
                            <i class="fa-solid fa-file-export"></i>
                            <span class="hidden sm:inline">バックアップ/復元</span>
                        </button>
                    </div>

                    <!-- Desktop Theme Toggle -->
                    <button id="theme-toggle-desktop" onclick="toggleTheme()" class="hidden md:inline-flex items-center justify-center w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer" title="ダーク/ライトモード切替">
                        <i class="fa-solid fa-moon dark:hidden"></i>
                        <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Offline Warning Banner (Shown automatically when navigator.onLine is false) -->
        <div id="offline-banner" class="hidden bg-amber-500/90 dark:bg-amber-600/90 text-white text-xs sm:text-sm py-1.5 px-4 text-center font-medium">
            <i class="fa-solid fa-wifi-slash mr-1.5"></i>現在オフラインモードです。直前に保存・収集されたキャッシュデータを表示しています（手動編集・メモ追記はそのまま保存されます）。
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-4 pb-8 sm:py-6 space-y-7 sm:space-y-8">

        <!-- ==========================================
             SECTION 1: MARKET INDICATORS (金利・為替・株価・プライムレート・金・BTC)
             ========================================== -->
        <section aria-labelledby="section-market-heading" class="pt-1">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-4 bg-white/60 dark:bg-slate-900/60 p-3 sm:p-0 sm:bg-transparent dark:sm:bg-transparent rounded-xl border border-slate-200/70 dark:border-slate-800/70 sm:border-none">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="w-1.5 h-5 sm:h-6 rounded-full bg-blue-600"></span>
                    <h2 id="section-market-heading" class="text-sm sm:text-lg font-bold text-slate-900 dark:text-white">
                        主要マーケット指標・長短プライム・金・BTC
                    </h2>
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-400">タップで数値編集</span>
                </div>
                <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-slate-500 dark:text-slate-400 pt-1 sm:pt-0 border-t border-slate-200/60 dark:border-slate-800/60 sm:border-none">
                    <span>日米10年金利差: <strong id="us-jp-spread" class="font-mono text-blue-600 dark:text-blue-400">--%</strong></span>
                    <div class="flex items-center gap-2.5">
                        <button onclick="toggleBondMatrixPanel()" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">
                            <i class="fa-solid fa-table-columns mr-1"></i>期間比較表
                        </button>
                        <span>•</span>
                        <button onclick="openAllIndicatorsModal()" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold">
                            <i class="fa-solid fa-pen-to-square mr-1"></i>一括修正
                        </button>
                    </div>
                </div>
            </div>

            <!-- 8-Card Grid for Indicators -->
            <div id="market-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
                <!-- Dynamically rendered by JS -->
            </div>

            <!-- Dedicated JGB 10Y vs US 10Y Multi-Period Comparison Matrix (1M / 3M / 6M / 1Y / 10Y) -->
            <div id="bond-matrix-panel" class="mt-4 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 sm:p-5 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-200 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                        <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">
                            日米10年物国債利回り ＆ 日米金利差 期間別推移マトリクス（1ヶ月・3ヶ月・半年・1年・10年前比）
                        </h3>
                    </div>
                    <div class="flex items-center gap-3 text-[11px]">
                        <span class="text-slate-400">※現在値を更新すると各期間との差（%）が自動再計算されます</span>
                        <button onclick="openIndicatorModal('jgb10y')" class="text-blue-600 dark:text-blue-400 hover:underline font-medium shrink-0">
                            <i class="fa-solid fa-sliders mr-1"></i>過去基準値を編集
                        </button>
                    </div>
                </div>
                <div class="overflow-x-auto -mx-2 px-2">
                    <table class="w-full text-left border-collapse text-xs font-mono">
                        <thead>
                            <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-sans text-slate-500 dark:text-slate-400">
                                <th class="py-2 px-2.5 min-w-[140px]">指標 / 金利差</th>
                                <th class="py-2 px-2.5 text-right bg-blue-50/50 dark:bg-blue-950/30 font-bold text-slate-900 dark:text-white">現在値</th>
                                <th class="py-2 px-2.5 text-right">1ヶ月前比<span class="block text-[10px] font-normal text-slate-400">(当時水準)</span></th>
                                <th class="py-2 px-2.5 text-right">3ヶ月前比<span class="block text-[10px] font-normal text-slate-400">(当時水準)</span></th>
                                <th class="py-2 px-2.5 text-right">半年前比<span class="block text-[10px] font-normal text-slate-400">(当時水準)</span></th>
                                <th class="py-2 px-2.5 text-right">1年前比<span class="block text-[10px] font-normal text-slate-400">(当時水準)</span></th>
                                <th class="py-2 px-2.5 text-right">10年前比<span class="block text-[10px] font-normal text-slate-400">(当時水準)</span></th>
                            </tr>
                        </thead>
                        <tbody id="bond-comparison-tbody" class="divide-y divide-slate-200/70 dark:divide-slate-800/70">
                            <!-- Populated dynamically by renderBondComparisonMatrix() -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ==========================================
             SECTION 1.5: INTERACTIVE CANDLESTICK CHART + 7D & 200D SMA
             ========================================== -->
        <section aria-labelledby="section-chart-heading" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 sm:p-6 shadow-sm">
            <!-- Chart Header & Asset Switcher -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-start sm:items-center gap-3">
                    <span class="w-1.5 h-7 rounded-full bg-amber-500 shrink-0 mt-1 sm:mt-0"></span>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 id="section-chart-heading" class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                                ローソク足チャート ＆ 7日・200日移動平均線 (SMA)
                            </h2>
                            <span id="chart-data-source-badge" class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                                ローカルキャッシュ保持済
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            短期トレンド（7日MA）と長期サポート/レジスタンス（200日MA・乖離率）をオフライン時も常時描画します
                        </p>
                    </div>
                </div>

                <!-- Asset Tabs & Period Zoom Controls -->
                <div class="flex flex-wrap items-center justify-between sm:justify-end gap-2">
                    <!-- Asset Selector -->
                    <div class="inline-flex p-1 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                        <button onclick="switchChartAsset('BTCJPY')" id="tab-asset-BTCJPY" class="chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-amber-500 text-white shadow-sm">
                            <i class="fa-brands fa-bitcoin"></i>
                            <span>BTC (円建て)</span>
                        </button>
                        <button onclick="switchChartAsset('GOLDJPY')" id="tab-asset-GOLDJPY" class="chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-1.5">
                            <i class="fa-solid fa-coins"></i>
                            <span>金 (円/g換算)</span>
                        </button>
                        <button onclick="switchChartAsset('XAUUSD')" id="tab-asset-XAUUSD" class="chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-1.5">
                            <i class="fa-solid fa-gem"></i>
                            <span>NY金 ($/oz)</span>
                        </button>
                        <button onclick="switchChartAsset('USDJPY')" id="tab-asset-USDJPY" class="chart-asset-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-1.5">
                            <i class="fa-solid fa-yen-sign"></i>
                            <span>ドル円</span>
                        </button>
                    </div>

                    <!-- Zoom Range Selector -->
                    <div class="inline-flex p-1 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                        <button onclick="setChartZoom(60)" data-zoom="60" class="chart-zoom-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">60日</button>
                        <button onclick="setChartZoom(120)" data-zoom="120" class="chart-zoom-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition">120日</button>
                        <button onclick="setChartZoom(240)" data-zoom="240" class="chart-zoom-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">240日(全体)</button>
                    </div>
                </div>
            </div>

            <!-- Live Summary KPI Strip & Hover Readout Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 my-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-950/90 border border-slate-200/80 dark:border-slate-800/80 text-xs font-mono">
                <div>
                    <span class="text-[10px] text-slate-400 block font-sans">日付 (日足)</span>
                    <strong id="hud-date" class="text-slate-800 dark:text-slate-200">--</strong>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 block font-sans">始値 (Open)</span>
                    <strong id="hud-open" class="text-slate-800 dark:text-slate-200 tabular-nums">--</strong>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 block font-sans">高値 (High)</span>
                    <strong id="hud-high" class="text-emerald-600 dark:text-emerald-400 tabular-nums">--</strong>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 block font-sans">安値 (Low)</span>
                    <strong id="hud-low" class="text-rose-600 dark:text-rose-400 tabular-nums">--</strong>
                </div>
                <div>
                    <span class="text-[10px] text-slate-400 block font-sans">終値 (Close)</span>
                    <strong id="hud-close" class="text-slate-900 dark:text-white font-bold tabular-nums">--</strong>
                </div>
                <div>
                    <span class="text-[10px] text-amber-500 font-sans font-semibold flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span>7日移動平均 (7SMA)
                    </span>
                    <strong id="hud-sma7" class="text-amber-600 dark:text-amber-400 tabular-nums">--</strong>
                </div>
                <div class="col-span-2 sm:col-span-1">
                    <span class="text-[10px] text-fuchsia-500 font-sans font-semibold flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-fuchsia-500 inline-block"></span>200日線 (乖離率)
                    </span>
                    <strong id="hud-sma200" class="text-fuchsia-600 dark:text-fuchsia-400 tabular-nums">--</strong>
                </div>
            </div>

            <!-- Interactive HTML5 Canvas Container -->
            <div class="relative w-full h-[320px] sm:h-[380px] select-none rounded-xl overflow-hidden bg-slate-950 border border-slate-800">
                <canvas id="ohlc-canvas" class="w-full h-full block cursor-crosshair"></canvas>
            </div>

            <!-- Chart Legend & Manual Candle Adjust Footer -->
            <div class="mt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center flex-wrap gap-4">
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-sm bg-emerald-500 inline-block"></span>陽線 (終値 ≧ 始値)
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-sm bg-rose-500 inline-block"></span>陰線 (終値 ＜ 始値)
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-4 h-0.5 bg-amber-400 inline-block"></span>7日移動平均線 (短期趨勢)
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-4 h-0.5 bg-fuchsia-500 inline-block"></span>200日移動平均線 (長期トレンド境界)
                    </span>
                </div>
                <div class="flex items-center gap-3">
                    <span id="chart-trend-signal" class="font-semibold text-emerald-600 dark:text-emerald-400">--</span>
                    <button onclick="syncOhlcFromPublicApi(true)" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
                        <i class="fa-solid fa-cloud-arrow-down mr-1"></i>日足データを再同期
                    </button>
                </div>
            </div>
        </section>

        <!-- ==========================================
             COLLAPSIBLE SECTION: LOAN & YIELD GAP SIMULATOR (返済・イールドギャップ試算電卓)
             ========================================== -->
        <section id="simulator-section" class="hidden transition-all duration-300">
            <div class="rounded-2xl bg-gradient-to-br from-indigo-950/90 via-slate-900 to-slate-900 text-white p-5 sm:p-6 border border-indigo-500/30 shadow-xl">
