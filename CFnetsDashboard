        function initChartInteractions() {
            const canvas = document.getElementById('ohlc-canvas');
            if (!canvas) return;

            function handlePointer(clientX) {
                const rect = canvas.getBoundingClientRect();
                const padLeft = 14;
                const padRight = 76;
                const plotW = rect.width - padLeft - padRight;
                const relX = clientX - rect.left - padLeft;

                const fullData = ohlcCache.series[currentChartAsset] || [];
                const visibleCount = Math.min(currentChartZoom, fullData.length);
                if (visibleCount <= 0) return;

                const idx = Math.floor((relX / plotW) * visibleCount);
                if (idx >= 0 && idx < visibleCount) {
                    chartHoverIndex = idx;
                    drawCandlestickChart();
                }
            }

            canvas.addEventListener('mousemove', (e) => handlePointer(e.clientX));
            canvas.addEventListener('touchmove', (e) => {
                if (e.touches && e.touches[0]) {
                    handlePointer(e.touches[0].clientX);
                }
            }, { passive: true });

            canvas.addEventListener('mouseleave', () => {
                chartHoverIndex = null;
                drawCandlestickChart();
            });

            window.addEventListener('resize', () => {
                drawCandlestickChart();
            });
        }

        // ==========================================
        // LIVE SYNC / EXCHANGE RATE + BTC + GOLD OHLC FETCH + FALLBACK
        // ==========================================
        async function syncOhlcFromPublicApi(showNotification = false) {
            if (!navigator.onLine) {
                if (showNotification) {
                    showToast('オフラインのためローカル保存済みの260日ローソク足データを表示しています', 'info');
                }
                return;
            }

            try {
                // Fetch 260 days of daily klines from public CORS-enabled Binance API for BTCUSDT & PAXGUSDT (Gold ounce token)
                const [btcRes, goldRes, fxRes] = await Promise.allSettled([
                    fetch('https://api.binance.com/api/v3/klines?symbol=BTCUSDT&interval=1d&limit=260'),
                    fetch('https://api.binance.com/api/v3/klines?symbol=PAXGUSDT&interval=1d&limit=260'),
                    fetch('https://open.er-api.com/v6/latest/USD')
                ]);

                let liveUsdJpy = Number(appState.indicators.find(i => i.id === 'usdjpy')?.value || 153.45);

                if (fxRes.status === 'fulfilled' && fxRes.value.ok) {
                    const fxJson = await fxRes.value.json();
                    if (fxJson?.rates?.JPY) {
                        liveUsdJpy = Number(fxJson.rates.JPY.toFixed(2));
                        const fxInd = appState.indicators.find(i => i.id === 'usdjpy');
                        if (fxInd) {
                            const prev = Number(fxInd.value);
                            const diff = Number((liveUsdJpy - prev).toFixed(2));
                            fxInd.value = liveUsdJpy;
                            if (diff !== 0) fxInd.change = diff;
                            fxInd.history = [...(fxInd.history || []).slice(-6), liveUsdJpy];
                            fxInd.updatedAt = formatDateTime(new Date());
                        }
                    }
                }

                // Parse BTC daily OHLC and convert to BTC/JPY
                if (btcRes.status === 'fulfilled' && btcRes.value.ok) {
                    const klines = await btcRes.value.json();
                    if (Array.isArray(klines) && klines.length > 200) {
                        ohlcCache.series.BTCJPY = klines.map(k => {
                            const d = new Date(k[0]);
                            return {
                                date: formatDateOnly(d),
                                open: Math.round(parseFloat(k[1]) * liveUsdJpy),
                                high: Math.round(parseFloat(k[2]) * liveUsdJpy),
                                low: Math.round(parseFloat(k[3]) * liveUsdJpy),
                                close: Math.round(parseFloat(k[4]) * liveUsdJpy)
                            };
                        });
                        const lastBtc = ohlcCache.series.BTCJPY[ohlcCache.series.BTCJPY.length - 1];
                        const prevBtc = ohlcCache.series.BTCJPY[ohlcCache.series.BTCJPY.length - 2];
                        const lastUsdClose = parseFloat(klines[klines.length - 1][4]);

                        const btcInd = appState.indicators.find(i => i.id === 'btc_jpy');
                        if (btcInd && lastBtc && prevBtc) {
                            btcInd.value = lastBtc.close;
                            btcInd.change = lastBtc.close - prevBtc.close;
                            btcInd.subValueStr = `BTC/USD: $${Math.round(lastUsdClose).toLocaleString('en-US')}`;
                            btcInd.history = ohlcCache.series.BTCJPY.slice(-7).map(x => x.close);
                            btcInd.updatedAt = formatDateTime(new Date());
                            btcInd.note = '市場APIより日足260日＆現在値取得済';
                        }
                    }
                }

                // Parse Gold (XAU/USD via PAXGUSDT spot gold proxy) and calculate domestic JPY/g reference (inkl. 10% consumption tax & retail spread factor)
                if (goldRes.status === 'fulfilled' && goldRes.value.ok) {
                    const gKlines = await goldRes.value.json();
                    if (Array.isArray(gKlines) && gKlines.length > 200) {
                        const TROY_OUNCE_GRAMS = 31.1034768;
                        const DOMESTIC_RETAIL_FACTOR = 1.10; // Domestic tax-included retail reference multiplier

                        ohlcCache.series.XAUUSD = gKlines.map(k => {
                            const d = new Date(k[0]);
                            return {
                                date: formatDateOnly(d),
                                open: Number(parseFloat(k[1]).toFixed(1)),
                                high: Number(parseFloat(k[2]).toFixed(1)),
                                low: Number(parseFloat(k[3]).toFixed(1)),
                                close: Number(parseFloat(k[4]).toFixed(1))
                            };
                        });

                        ohlcCache.series.GOLDJPY = gKlines.map(k => {
                            const d = new Date(k[0]);
                            const factor = (liveUsdJpy / TROY_OUNCE_GRAMS) * DOMESTIC_RETAIL_FACTOR;
                            return {
                                date: formatDateOnly(d),
                                open: Math.round(parseFloat(k[1]) * factor),
                                high: Math.round(parseFloat(k[2]) * factor),
                                low: Math.round(parseFloat(k[3]) * factor),
                                close: Math.round(parseFloat(k[4]) * factor)
                            };
                        });

                        const lastGoldJpy = ohlcCache.series.GOLDJPY[ohlcCache.series.GOLDJPY.length - 1];
                        const prevGoldJpy = ohlcCache.series.GOLDJPY[ohlcCache.series.GOLDJPY.length - 2];
                        const lastXau = ohlcCache.series.XAUUSD[ohlcCache.series.XAUUSD.length - 1];

                        const goldInd = appState.indicators.find(i => i.id === 'gold_jpy');
                        if (goldInd && lastGoldJpy && prevGoldJpy && lastXau) {
                            goldInd.value = lastGoldJpy.close;
                            goldInd.change = lastGoldJpy.close - prevGoldJpy.close;
                            goldInd.subValueStr = `NY金: $${lastXau.close.toLocaleString('en-US')}/oz`;
                            goldInd.subtitle = `XAU/USD $${lastXau.close}/oz・円換算税込参考`;
                            goldInd.history = ohlcCache.series.GOLDJPY.slice(-7).map(x => x.close);
                            goldInd.updatedAt = formatDateTime(new Date());
                            goldInd.note = '市場APIより日足260日＆円換算取得済';
                        }
                    }
                }

                ohlcCache.lastSynced = formatDateTime(new Date());
                ohlcCache.source = 'ライブ市場API同期済（オフライン自動保持）';
                saveOhlcCache();
                saveState(true);
                renderMarketCards();
                drawCandlestickChart();

                if (showNotification) {
                    showToast('金・BTC・ドル円の最新価格と過去260日分のローソク足データを同期・保存しました', 'success');
                }
            } catch (err) {
                console.warn('OHLC Live fetch fallback:', err);
                if (showNotification) {
                    showToast('外部API通信が制限されているため、内蔵キャッシュデータを表示しています', 'info');
                }
            }
        }

        async function syncLiveMarketData() {
            const icon = document.getElementById('sync-icon');
            if (icon) icon.classList.add('fa-spin');

            if (!navigator.onLine) {
                setTimeout(() => {
                    if (icon) icon.classList.remove('fa-spin');
                    showToast('現在オフラインのため通信をスキップし、ローカル保存データを維持しています。', 'info');
