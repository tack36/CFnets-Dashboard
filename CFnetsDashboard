                    BTCJPY: generateSeededOhlcSeries(260, 10485000, 0.026, 0.0014, 101),
                    GOLDJPY: generateSeededOhlcSeries(260, 14920, 0.0095, 0.0009, 202),
                    XAUUSD: generateSeededOhlcSeries(260, 2745.0, 0.0085, 0.0008, 303),
                    USDJPY: generateSeededOhlcSeries(260, 153.45, 0.0055, 0.0002, 404)
