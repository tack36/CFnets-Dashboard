        // ==========================================
        // SEEDED 260-DAY OHLC CANDLESTICK GENERATOR (FOR OFFLINE / INITIAL CACHE)
        // Generates realistic 260-day daily OHLC histories so 7-day & 200-day SMA work immediately
        // ==========================================
        function generateSeededOhlcSeries(daysCount, targetEndClose, volatilityPct, driftPerDay, seedOffset) {
            const series = [];
            const prices = new Array(daysCount);
            prices[daysCount - 1] = targetEndClose;

            // Walk backward deterministically so the final candle matches current live/saved indicator price
            let s = seedOffset || 42;
            function pseudoRand() {
                s = (s * 1664525 + 1013904223) % 4294967296;
                return (s / 4294967296) - 0.5; // -0.5 to +0.5
            }

            for (let i = daysCount - 2; i >= 0; i--) {
                const shock = pseudoRand() * volatilityPct * 2;
                const prevClose = prices[i + 1] / (1 + driftPerDay + shock);
                prices[i] = prevClose;
            }

            const today = new Date();
            for (let i = 0; i < daysCount; i++) {
                const d = new Date(today);
                d.setDate(today.getDate() - (daysCount - 1 - i));
                const dateStr = formatDateOnly(d);

                const close = prices[i];
                const open = i === 0 ? close * (1 - pseudoRand() * volatilityPct) : prices[i - 1];
                const bodyMax = Math.max(open, close);
                const bodyMin = Math.min(open, close);
                const upperWick = Math.abs(pseudoRand()) * volatilityPct * 1.4 * close;
                const lowerWick = Math.abs(pseudoRand()) * volatilityPct * 1.4 * close;
                const high = bodyMax + upperWick;
                const low = Math.max(0.01, bodyMin - lowerWick);

                series.push({
                    date: dateStr,
                    open: Number(open.toPrecision(6)),
                    high: Number(high.toPrecision(6)),
                    low: Number(low.toPrecision(6)),
                    close: Number(close.toPrecision(6))
                });
            }
            return series;
        }

